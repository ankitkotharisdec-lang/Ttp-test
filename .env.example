# Supabase project (Settings > API). The publishable key is safe for the server; never use the secret/service_role key here.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Supabase Postgres (Connect > Session pooler URI). Replace [YOUR-PASSWORD] with your database password.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me
